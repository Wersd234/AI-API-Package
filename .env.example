# =============================================================================
# AI-RP-Proxy — pure two-stage relay, zero prompt injection
# Copy to .env and set your two device IPs.
# =============================================================================

PROXY_HOST=0.0.0.0
PROXY_PORT=5000
VIRTUAL_MODEL_NAME=rp-two-stage
LOG_LEVEL=INFO

# --- Stage 1: content model (device A) ---
STAGE1_URL=http://DEVICE_A_IP:8080/v1
STAGE1_MODEL=qwen-3.8-flash
STAGE1_MAX_TOKENS=1024
# Thinking budget added on top of the story budget (reasoning tokens count
# toward max_tokens in llama.cpp; without this long thinking truncates story)
STAGE1_THINKING_HEADROOM=2048
# With a 256k context nearly full, prefill alone on a 177B MoE can take tens
# of minutes; thinking + generation goes on top. Pure hang-detector.
STAGE1_TIMEOUT=7200
# Strip leaked <think> blocks before stage 2 (set false if your stage-1
# llama-server already uses --reasoning-format to separate reasoning)
STAGE1_STRIP_REASONING=true
# Split stage-1 output at the first functional-block marker: the story body
# goes to stage 2 immediately (much earlier first token) and the tail is
# appended UNPOLISHED, so MVU blocks can never be mangled by the style model
STAGE1_TAIL_SPLIT=true
STAGE1_TAIL_MARKERS=<UpdateVariable>

# --- Stage 2: style model (device B) ---
STAGE2_URL=http://DEVICE_B_IP:8081/v1
STAGE2_MODEL=gemma-4-26b
STAGE2_MAX_TOKENS=1536
STAGE2_TIMEOUT=120
# Polishing system prompt file — edit freely, re-read on every request,
# no proxy restart needed. Leave unset to run stage 2 with no system prompt.
STAGE2_PROMPT_FILE=stage2_prompt.txt
# Tag blocks extracted from ST messages and forwarded to stage 2 automatically
# (comma-separated; add more tags as needed)
STAGE2_STYLE_TAGS=核心文字风格

# --- Optional: force stage-2 sampling (leave commented to inherit ST's values) ---
# STAGE2_TEMPERATURE=0.6
# STAGE2_TOP_P=0.9

# --- SSE keepalive interval while stage 1 generates (seconds) ---
KEEPALIVE_INTERVAL=5